# Copy this to frontend/.env.local — fill in real values, never commit the real .env.local

NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# In production, point this at the live Railway backend URL instead.

# If you add a separate server-side secret (e.g. for server actions calling Strapi
# with an API token), keep it WITHOUT the NEXT_PUBLIC_ prefix so it never reaches the browser:
STRAPI_API_TOKEN=
