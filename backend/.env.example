# Strapi Server Configuration
HOST=0.0.0.0
PORT=1337
# Set to your Railway public domain (e.g., https://pathshala-backend.up.railway.app)
PUBLIC_URL=https://your-strapi-domain.up.railway.app
# Frontend URL for CORS authorization
FRONTEND_URL=https://your-pathshala-frontend.vercel.app

# Database Configuration (Auto-provided by Railway PostgreSQL when linked, or configured manually)
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://postgres:password@host:5432/railway
DATABASE_SSL=false

# Strapi Secrets (Generate with: openssl rand -base64 32)
APP_KEYS="toBeModified1,toBeModified2,toBeModified3,toBeModified4"
API_TOKEN_SALT=tobemodified-salt-32chars-key
ADMIN_JWT_SECRET=tobemodified-admin-secret-32chars
TRANSFER_TOKEN_SALT=tobemodified-transfer-salt-32chars
JWT_SECRET=tobemodified-jwt-secret-32chars
