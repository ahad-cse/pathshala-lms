# Copy this to backend/.env — fill in real values, never commit the real .env

HOST=0.0.0.0
PORT=1337

# Generate with: openssl rand -base64 32 (do this 4 times for the 4 keys below)
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# Database (Railway will give you these when you provision Postgres)
DATABASE_CLIENT=postgres
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=true

# Frontend origin, for CORS
FRONTEND_URL=http://localhost:3000
